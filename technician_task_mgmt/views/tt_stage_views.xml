<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tt_task_stage_tree" model="ir.ui.view">
        <field name="name">tt.task.stage.tree</field>
        <field name="model">tt.task.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="state"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="view_tt_task_stage_form" model="ir.ui.view">
        <field name="name">tt.task.stage.form</field>
        <field name="model">tt.task.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="state"/>
                        <field name="fold"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tt_task_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">tt.task.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

