<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions: must be defined before menus that reference them -->
    <record id="action_tt_task" model="ir.actions.act_window">
        <field name="name">Technician Tasks</field>
        <field name="res_model">tt.task</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="context">{'search_default_open_tasks': 1}</field>
        <field name="search_view_id" ref="view_tt_task_search"/>
    </record>

    <record id="action_tt_task_type" model="ir.actions.act_window">
        <field name="name">Task Types</field>
        <field name="res_model">tt.task.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tt_task_tag" model="ir.actions.act_window">
        <field name="name">Task Tags</field>
        <field name="res_model">tt.task.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tt_building_tag" model="ir.actions.act_window">
        <field name="name">Location Tags</field>
        <field name="res_model">tt.building.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tt_task_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">tt.task.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_tt_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="technician_task_mgmt.view_res_config_settings_tt_form"/>
        <field name="target">new</field>
        <field name="context">{'module': 'technician_task_mgmt'}</field>
    </record>

    <!-- Menu Root -->
    <menuitem id="menu_tt_root" name="Max Techniciens" sequence="10" web_icon="technician_task_mgmt,static/description/icon.png"/>

    <!-- Submenus -->
    <menuitem id="menu_tt_tasks" name="Tasks" parent="menu_tt_root" sequence="10" action="action_tt_task" groups="technician_task_mgmt.group_technician,technician_task_mgmt.group_tech_manager"/>
    <menuitem id="menu_tt_types" name="Types" parent="menu_tt_root" sequence="20" action="action_tt_task_type" groups="technician_task_mgmt.group_tech_manager"/>
    <menuitem id="menu_tt_tags" name="Tags" parent="menu_tt_root" sequence="30" action="action_tt_task_tag" groups="technician_task_mgmt.group_tech_manager"/>
    <menuitem id="menu_tt_location_tags" name="Location Tags" parent="menu_tt_root" sequence="35" action="action_tt_building_tag" groups="technician_task_mgmt.group_tech_manager"/>
    <menuitem id="menu_tt_reports" name="Reports" parent="menu_tt_root" sequence="40" groups="technician_task_mgmt.group_tech_manager"/>
    <menuitem id="menu_tt_stages" name="Stages" parent="menu_tt_root" sequence="50" action="action_tt_task_stage" groups="technician_task_mgmt.group_tech_manager"/>
    <menuitem id="menu_tt_settings" name="Settings" parent="menu_tt_root" sequence="60" action="action_tt_settings" groups="technician_task_mgmt.group_tech_manager"/>

</odoo>
