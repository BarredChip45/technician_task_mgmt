<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="group_tech_manager" model="res.groups">
        <field name="name">Technician Task Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="group_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <!-- Record Rules -->
    <!-- Technicians: can see/update only their tasks (or if they are followers) -->
    <record id="tt_task_rule_technician_own" model="ir.rule">
        <field name="name">Technician Own Tasks</field>
        <field name="model_id" ref="model_tt_task"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id','=',user.id), ('message_partner_ids','in',[user.partner_id.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Technicians: only lines of their tasks -->
    <record id="tt_material_line_rule_technician" model="ir.rule">
        <field name="name">Technician Material Lines Own Tasks</field>
        <field name="model_id" ref="model_tt_material_line"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('task_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="tt_subtask_rule_technician" model="ir.rule">
        <field name="name">Technician Subtasks Own Tasks</field>
        <field name="model_id" ref="model_tt_subtask"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('task_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="tt_timer_line_rule_technician" model="ir.rule">
        <field name="name">Technician Timer Lines Own Tasks</field>
        <field name="model_id" ref="model_tt_timer_line"/>
        <field name="groups" eval="[(4, ref('group_technician'))]"/>
        <field name="domain_force">[('task_id.employee_id.user_id', '=', user.id)]</field>
    </record>


    <!-- Managers: full access is via access rights; no extra rules -->
</odoo>
