<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tt_stage_draft" model="tt.task.stage">
        <field name="name">New</field>
        <field name="sequence">1</field>
        <field name="state">draft</field>
        <field name="fold">0</field>
    </record>
    <record id="tt_stage_in_progress" model="tt.task.stage">
        <field name="name">In Progress</field>
        <field name="sequence">10</field>
        <field name="state">in_progress</field>
        <field name="fold">0</field>
    </record>
    <record id="tt_stage_finished_today" model="tt.task.stage">
        <field name="name">Finished for Today</field>
        <field name="sequence">80</field>
        <field name="state">in_progress</field>
        <field name="fold">0</field>
    </record>

    <record id="tt_stage_done" model="tt.task.stage">
        <field name="name">Done</field>
        <field name="sequence">90</field>
        <field name="state">done</field>
        <field name="fold">1</field>
    </record>
    <record id="tt_stage_cancel" model="tt.task.stage">
        <field name="name">Cancelled</field>
        <field name="sequence">100</field>
        <field name="state">cancel</field>
        <field name="fold">1</field>
    </record>
</odoo>

